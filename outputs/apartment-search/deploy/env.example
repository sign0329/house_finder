# Copy to .env.production; chmod 600 .env.production. Never commit credentials.
DOMAIN=your-domain.example.com
DB_USER=apartments
DB_PASSWORD=
DB_POOL_SIZE=10
APP_IMAGE=house-finder-app:production
# Optional: used only by the one-shot importer, never app or proxy.
MOLIT_SERVICE_KEY=
MOLIT_MONTH=202609
MOLIT_REGIONS=11110:서울:종로구
MOLIT_FROM=
MOLIT_TO=

# Optional browser JavaScript key; restrict SDK domains in Kakao Developers
KAKAO_MAP_JAVASCRIPT_KEY=

# Enable each provider only after configuring credentials and callback URLs.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
SOCIAL_LOGIN_BASE_URL=http://localhost:8082
