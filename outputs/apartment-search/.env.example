DB_USER=apartments
# Replace this example value. Never commit your local .env files.
DB_PASSWORD=change-this-local-password
DB_POOL_SIZE=10
# Keep false for real public data. Demo and public data must not be mixed.
DEMO_DATA=false
# Host port for the full app+DB stack; container app port stays 8080.
PORT=8082
# Only the one-shot importer receives this key. Encoding and Decoding both work.
MOLIT_SERVICE_KEY=
MOLIT_MONTH=202609
